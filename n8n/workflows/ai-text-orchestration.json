{
  "name": "ai-text-orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/ai-text",
        "authentication": "headerAuth",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "url": "={{ $env.TEXT_ENGINE_URL }}/api/generate",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "prompt",
              "value": "={{ $json.body.payload.prompt }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Call Text Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 450, 300 ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "url": "={{ $json.body.callbackUrl || $env.DJANGO_HOST + '/api/v1/n8n/callback/' }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "correlationId",
              "value": "={{ $('Webhook').item.json.body.correlationId }}"
            },
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "result",
              "value": "={{ $json }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback to Django",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 650, 300 ]
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [ 250, 500 ]
    },
    {
      "parameters": {
        "url": "={{ $('Webhook').first().json.body.callbackUrl || $env.DJANGO_HOST + '/api/v1/n8n/callback/' }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "correlationId",
              "value": "={{ $('Webhook').first().json.body.correlationId || 'unknown' }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "errorDetails",
              "value": "={{ $json.error.message }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback Error to Django",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 450, 500 ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Call Text Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Text Engine": {
      "main": [
        [
          {
            "node": "Callback to Django",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Callback Error to Django",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
