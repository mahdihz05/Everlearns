{
  "name": "agent-tools-text",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/agent-tool-text",
        "authentication": "headerAuth",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": "ai-text-orchestration"
      },
      "name": "Execute AI Text Orchestration",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        250,
        500
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Webhook').first().json.body.callbackUrl || $env.DJANGO_HOST + '/api/v1/n8n/callback/' }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "correlationId",
              "value": "={{ $('Webhook').first().json.body.correlationId || 'unknown' }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "errorDetails",
              "value": "={{ $json.error.message }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback Error to Django",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        450,
        500
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Execute AI Text Orchestration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Callback Error to Django",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}