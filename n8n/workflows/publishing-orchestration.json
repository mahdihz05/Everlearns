{
  "name": "publishing-orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/publish",
        "authentication": "headerAuth",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.payload.isScheduled }}",
              "value2": true
            }
          ]
        }
      },
      "name": "If Scheduled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": "subflow-publishing-scheduled"
      },
      "name": "Scheduled Publish Flow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "workflowId": "subflow-publishing-immediate"
      },
      "name": "Immediate Publish Flow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        650,
        400
      ]
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        250,
        500
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Webhook').first().json.body.callbackUrl || $env.DJANGO_HOST + '/api/v1/n8n/callback/' }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "correlationId",
              "value": "={{ $('Webhook').first().json.body.correlationId || 'unknown' }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "errorDetails",
              "value": "={{ $json.error.message }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback Error to Django",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        450,
        500
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "If Scheduled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Scheduled": {
      "main": [
        [
          {
            "node": "Scheduled Publish Flow",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Immediate Publish Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Callback Error to Django",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}