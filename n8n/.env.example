# Environment Variable Conventions for n8n

# Security
N8N_WEBHOOK_SECRET=your_secure_webhook_secret_here

# Django Integration
DJANGO_API_TOKEN=your_django_service_token
DJANGO_HOST=https://django-api.example.com

# Core Services
TEXT_ENGINE_URL=https://text-engine.example.com
VISUAL_ENGINE_URL=https://visual-engine.example.com

# External Integration Example (Use n8n credential objects where possible instead)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
